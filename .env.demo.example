APP_NAME="Mica ERP Demo"
APP_ENV=production
APP_KEY=REPLACE_WITH_GENERATED_LARAVEL_KEY
APP_DEBUG=false
APP_URL=https://YOUR-BACKEND.onrender.com
FRONTEND_URL=https://YOUR-FRONTEND.vercel.app
TRUSTED_PROXIES=*
CORS_ALLOWED_ORIGINS=https://YOUR-FRONTEND.vercel.app
DEMO_MODE=true
DEMO_DATABASE=mica_demo
DEMO_ANCHOR_DATE=2026-10-02
DB_CONNECTION=mysql
DB_HOST=YOUR-MANAGED-DB-HOST
DB_PORT=3306
DB_DATABASE=mica_demo
DB_USERNAME=DEDICATED_DEMO_USER
DB_PASSWORD=REPLACE_WITH_SECRET
DB_URL=
DB_CHARSET=utf8mb4
DB_COLLATION=utf8mb4_unicode_ci
MYSQL_ATTR_SSL_CA=/etc/secrets/managed-db-ca.pem
MYSQL_ATTR_SSL_VERIFY_SERVER_CERT=true
SESSION_DRIVER=database
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax
SANCTUM_STATEFUL_DOMAINS=
CACHE_STORE=database
QUEUE_CONNECTION=sync
MAIL_MAILER=array
FILESYSTEM_DISK=local
LOG_CHANNEL=stderr
LOG_LEVEL=warning
BCRYPT_ROUNDS=12
